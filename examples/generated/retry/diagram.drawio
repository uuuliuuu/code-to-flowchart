ry"><mxGeometry as="geometry" x="0" y="0" relative="1"><mxPoint as="offset" x="106.5" y="-13.0" /><Array as="points"><mxPoint x="412.0" y="1154.5" /><mxPoint x="412.0" y="1154.5" /></Array></mxGeometry></mxCell><mxCell id="e:6" value="回到迭代条件检查" style="edgeStyle=none;html=0;endArrow=block;exitX=0.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;fontSize=13;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=190;" edge="1" parent="1" source="n:retry" target="n:check"><mxGeometry as="geometry" x="0" y="0" relative="1"><mxPoint as="offset" x="69.0" y="-20.5" /><Array as="points"><mxPoint x="35" y="1257.0" /><mxPoint x="35" y="355.0" /></Array></mxGeometry></mxCell><mxCell id="e:7" value="break：fetch 返回 None" style="edgeStyle=none;html=0;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;fontSize=13;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=190;" edge="1" parent="1" source="n:pending" target="n:break"><mxGeometry as="geometry" x="0" y="0" relative="1"><mxPoint as="offset" x="0.0" y="22.0" /><Array as="points"><mxPoint x="412.0" y="1154.5" /><mxPoint x="852.0" y="1154.5" /></Array></mxGeometry></mxCell><mxCell id="e:8" value="return：fetch 返回非 None" style="edgeStyle=none;html=0;endArrow=block;exitX=1.0;exitY=0.5;entryX=1.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;fontSize=13;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=190;" edge="1" parent="1" source="n:pending" target="n:return"><mxGeometry as="geometry" x="0" y="0" relative="1"><mxPoint as="offset" x="-104.625" y="199.5" /><Array as="points"><mxPoint x="1246.0" y="1027.0" /><mxPoint x="1246.0" y="1462.0" /></Array></mxGeometry></mxCell><mxCell id="e:9" value="raise：未处理异常或 audit 抛出" style="edgeStyle=none;html=0;endArrow=block;exitX=1.0;exitY=0.5;entryX=1.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;fontSize=13;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=190;" edge="1" parent="1" source="n:pending" target="n:raise"><mxGeo