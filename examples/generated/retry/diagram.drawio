<mxfile host="code-to-flowchart" version="1.0"><diagram id="outer" name="总览 · key 外层循环"><mxGraphModel page="1" pageWidth="1249" pageHeight="1691"><root><mxCell id="0" /><mxCell id="1" parent="0" /><object id="n:entry" label="fetch_first(keys, client, audit)" source="[{&quot;file&quot;: &quot;examples/source/retry.py&quot;, &quot;start&quot;: 1, &quot;end&quot;: 1}]"><mxCell style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontSize=15;fillColor=#d9f3eb;strokeColor=#7b8ba2;arcSize=50;" vertex="1" parent="1"><mxGeometry as="geometry" x="309.0" y="80.0" width="270" height="90" /></mxCell></object><object id="n:next" label="取下一个 key：存在？" source="[{&quot;file&quot;: &quot;examples/source/retry.py&quot;, &quot;start&quot;: 2, &quot;end&quot;: 2}]"><mxCell style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fontSize=15;fillColor=#fff2ca;strokeColor=#7b8ba2;" vertex="1" parent="1"><mxGeometry as="geometry" x="294.0" y="285.0" width="300" height="140" /></mxCell></object><object id="n:none" label="正常耗尽：返回 None" source="[{&quot;file&quot;: &quot;examples/source/retry.py&quot;, &quot;start&quot;: 16, &quot;end&quot;: 16}]"><mxCell style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontSize=15;fillColor=#d9f3eb;strokeColor=#7b8ba2;arcSize=50;" vertex="1" parent="1"><mxGeometry as="geometry" x="749.0" y="540.0" width="270" height="90" /></mxCell></object><object id="n:empty" label="not key?" source="[{&quot;file&quot;: &quot;examples/source/retry.py&quot;, &quot;start&quot;: 3, &quot;end&quot;: 3}]"><mxCell style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fontSize=15;fillColor=#fff2ca;strokeColor=#7b8ba2;" vertex="1" parent="1"><mxGeometry as="geometry" x="294.0" y="745.0" width="300" height="140" /></mxCell></object><object id="n:inner" label="当前 key：运行 attempt 循环&#10;所有离开 try 的路径先执行 finally" source="[{&quot;file&quot;: &quot;examples/source/retry.py&quot;, &quot;start&quot;: 5, &quot;end&quot;: 15}]" link="data:page/id,attempts"><mxCell style="shape=rectangle